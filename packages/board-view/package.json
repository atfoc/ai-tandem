{
  "name": "@aiwb/board-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Excalidraw behind the board bridge (AD-51): the endpoint, its in-page view for the web build (`build:web`) and the one-file page for the phone's web view (`build:webview`).",
  "exports": {
    "./dist-webview/*": "./dist-webview/*",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "check": "tsc --noEmit",
    "build:webview": "node build.mjs webview",
    "build:web": "node build.mjs web"
  },
  "dependencies": {
    "@aiwb/board-bridge": "*",
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
