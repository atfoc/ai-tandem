{
  "name": "@aiwb/board-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The board host (better-board): one tldraw TLSocketRoom per open new board, in a Node process that is a client of the server's client API. Windows' sync messages come and go through the server; agents' tools are answered here.",
  "scripts": {
    "test": "node --import ./test/tsx-hook.ts --test --test-force-exit --experimental-strip-types 'test/*.test.ts'",
    "check": "tsc --noEmit",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@aiwb/board-tl": "*",
    "@aiwb/conn": "*",
    "@aiwb/headless": "*",
    "@resvg/resvg-js": "2.6.2",
    "@tldraw/assets": "5.6.0",
    "@tldraw/editor": "5.6.0",
    "@tldraw/state": "5.6.0",
    "@tldraw/store": "5.6.0",
    "@tldraw/sync-core": "5.6.0",
    "@tldraw/tlschema": "5.6.0",
    "linebreak": "1.1.0",
    "linkedom": "0.18.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "skia-canvas": "4.0.0",
    "tldraw": "5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "27.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
