#!/usr/bin/env node
// A scripted stand-in for the `claude` CLI, for tests that start a whole server:
//   ai-whiteboard serve ... -claude /path/to/fake-claude        (agenttest.FakeClaude writes it)
// What it answers is decided by the user message, so a test controls it through the message
// itself:
//   plain text                    -> replies "FAKE(<model>): <text>"
//   [[sleep 2.5]]                 -> waits that many seconds before answering (an interrupt ends the wait)
//   <<sleep 2.5>>                 -> every directive has this second spelling, for use inside the JSON of [[mcp ...]]
//   [[mcp TOOL {json args}]]      -> calls that tool on the app's MCP endpoint (from --mcp-config)
//                                    before answering, and puts the tool's text in the reply. The
//                                    JSON may hold an array (a single "]"); a directive ends at "]]"
//   [[write PATH TEXT]]           -> writes TEXT and a newline to the file PATH (relative to the
//                                    process's working directory; its folders are made), as an agent
//                                    that edits a file; "\n" in TEXT is a line break
//   [[ask TOOL {json input}]]     -> shows a call of that tool, asks permission for it as claude does
//                                    (a can_use_tool control request), waits for the answer and puts
//                                    "ask TOOL -> allow" or "ask TOOL -> deny" in the reply; an interrupt
//                                    ends the wait and the turn. No input: {}; no tool name: Bash
//   [[tools]]                     -> calls tools/list and puts the names in the reply
//   [[final TEXT]]                -> remembered by the process; a later turn whose message is a
//                                    <subagent-results> block is answered with TEXT alone
//   [[fail some text]]            -> ends the turn as an error with that text
//   [[exit 3]]                    -> the process exits with that status mid-turn
//   [[cost 0.01]]                 -> the turn costs that many dollars: the result line's total_cost_usd
//                                    (cumulative for the process, as claude's is) rises by it, its
//                                    usage.output_tokens is 100,000 tokens per dollar for this turn,
//                                    and modelUsage.<model>.outputTokens is their sum for the process.
//                                    Every turn also adds 10 input, 1000 cache read and 100 cache
//                                    write tokens to the process's modelUsage
//   [[if TEXT]]                   -> the directives after it, up to the next [[if …]], run only when the
//                                    message without its directives contains TEXT ([[if]] alone: always)
//   [[bg 60]]                     -> starts a real background command, as claude's Bash tool with
//                                    run_in_background does: shows the tool call, lists the process's live
//                                    background tasks (system/background_tasks_changed), announces the
//                                    new one (task_started), answers the call, and starts
//                                    `sh -c "sleep 60; true"` detached (its own process group, not unref'd),
//                                    the way claude starts its shell. The reply is "waiting" when the
//                                    message has no other text. A message may start several. When the
//                                    command ends the process says so (task_updated, task_notification,
//                                    a background_tasks_changed without it) and begins a turn by itself
//                                    (status requesting, the text "bg<n> done", a result whose origin is
//                                    task-notification), after any turn that is running. The seconds
//                                    may be fractional; one that no other process uses (60.481516) tells
//                                    a test its own command in the process list
//   [[bglate 60]]                 -> as [[bg]], but the shell is started late, as a claude that announces a command
//                                    before it has spawned it would: the tool call, the task list and
//                                    task_started come first, then the process waits for the file
//                                    $FAKE_CLAUDE_BG_GATE to exist (at once when that is not set),
//                                    starts the shell, and only then does the turn go on and end. A
//                                    test uses it for a command that cannot be found when it is announced
//   [[leave]]                     -> after this turn's result the process exits 0 and leaves its children
//                                    as they are (a claude that ends by itself while its commands run).
//                                    With FAKE_CLAUDE_LEAVE_GATE=<file> set it first waits for that file
//                                    to exist: the app finds a command's group by a walk of the process
//                                    tree that a process leaving at once outruns, and a test lets it
//                                    exit when the walk is done
// While a background command runs the process does not exit when its stdin closes, as the real one
// does not; it exits once the last command has ended and the turn that follows has been written (at
// once when none runs).
// FAKE_CLAUDE_BGPIDS=<file> gets the pid of each background command's shell, one per line.
// FAKE_CLAUDE_LOG=<file> appends one JSON line per invocation and per stdin line, and {"turn":"self"}
// each time a turn begins after stdin has closed: a turn nobody asked for, such as the one the
// notice of a command that ended starts. A process that was stopped must write none.
const fs = require("node:fs");
const readline = require("node:readline");
const args = process.argv.slice(2);
const log = (o) => { if (process.env.FAKE_CLAUDE_LOG) fs.appendFileSync(process.env.FAKE_CLAUDE_LOG, JSON.stringify({ pid: process.pid, ...o }) + "\n"); };
const arg = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
log({ start: args, cwd: process.cwd() });

if (args[0] === "auth") process.exit(0);                       // `claude auth status`: signed in
if (!args.includes("--input-format")) {                        // one-shot runs: /usage, the chat namer
  if (args.includes("/usage")) process.exit(1);
  console.log("Fake title");
  process.exit(0);
}

const model = arg("--model") || "sonnet";
const session = arg("--session-id") || arg("--resume") || "fake-session";
let mcp = null;
// --mcp-config is a JSON string or, as the app passes it, the path of a JSON file.
try {
  let cfg = arg("--mcp-config") || "{}";
  if (!cfg.trimStart().startsWith("{")) cfg = fs.readFileSync(cfg, "utf8");
  mcp = Object.values(JSON.parse(cfg).mcpServers || {})[0] || null;
} catch { /* none */ }
const out = (o) => process.stdout.write(JSON.stringify(o) + "\n");
const uuid = () => require("node:crypto").randomUUID();
let rpcId = 0;
const asks = new Map(); // request id -> resolve, for [[ask ...]]
async function rpc(method, params) {
  const r = await fetch(mcp.url, { method: "POST", headers: { "Content-Type": "application/json", ...(mcp.headers || {}) },
    body: JSON.stringify({ jsonrpc: "2.0", id: ++rpcId, method, params }) });
  return r.json();
}
async function callTool(name, input) {
  if (!mcp) return "no --mcp-config";
  const body = await rpc("tools/call", { name, arguments: input });
  return (body.result?.content || []).map((c) => c.text ?? "").join("\n") || JSON.stringify(body);
}

// A directive is [[verb rest]] or <<verb rest>>; the second form is for one nested in the JSON of an [[mcp ...]].
const DIRECTIVE = /\[\[(\w+)\s*((?:[^\]]|\](?!\]))*)\]\]|<<(\w+)\s*([^>]*)>>/g;
const TOKENS_PER_USD = 100000;
let turns = 0, current = null; // current: { cancel() } while a turn runs
let finalText = null;                    // kept for the reply to <subagent-results>
const bgTasks = new Map();               // live background commands: id -> { seconds }, in the order they started
let bgCount = 0, pending = 0, stdinClosed = false, leaving = false;
function exitWhenDone() { if (stdinClosed && bgTasks.size === 0 && pending === 0) process.exit(0); }
const bgList = () => ({ type: "system", subtype: "background_tasks_changed", session_id: session, uuid: uuid(),
  tasks: [...bgTasks].map(([id, t]) => ({ task_id: id, task_type: "local_bash", description: `sleep ${t.seconds}` })) });
// bgStart runs [[bg SECONDS]]: the stream claude writes for a Bash call in the background, then the
// shell itself, started as claude starts it. A turn that begins by itself follows its end.
// With late, the shell is started only after the announcement and the file $FAKE_CLAUDE_BG_GATE.
async function bgStart(seconds, late = false) {
  const n = ++bgCount, id = `bg${n}`, tool = `toolu_bg${n}`, command = `sleep ${seconds}`;
  out({ type: "assistant", uuid: uuid(), session_id: session, parent_tool_use_id: null,
    message: { id: "msg_" + uuid().slice(0, 8), role: "assistant", model, content: [{ type: "tool_use", id: tool, name: "Bash", input: { command, run_in_background: true } }] } });
  const spawn = () => {
    const child = require("node:child_process").spawn("sh", ["-c", `${command}; true`], { detached: true, stdio: "ignore" });
    child.on("error", () => {});
    if (process.env.FAKE_CLAUDE_BGPIDS && child.pid) fs.appendFileSync(process.env.FAKE_CLAUDE_BGPIDS, child.pid + "\n");
    return child;
  };
  const child = late ? null : spawn();
  bgTasks.set(id, { seconds });
  out(bgList());
  out({ type: "system", subtype: "task_started", task_id: id, tool_use_id: tool, description: command, task_type: "local_bash", is_backgrounded: true, session_id: session, uuid: uuid() });
  out({ type: "user", uuid: uuid(), session_id: session, parent_tool_use_id: null,
    message: { role: "user", content: [{ type: "tool_result", tool_use_id: tool, content: `Command running in background with ID: ${id}.` }] } });
  const onExit = (child) => child.on("exit", (code) => {
    const ok = code === 0;
    bgTasks.delete(id);
    out({ type: "system", subtype: "task_updated", task_id: id, patch: { status: ok ? "completed" : "killed", end_time: Date.now() }, session_id: session, uuid: uuid() });
    out({ type: "system", subtype: "task_notification", task_id: id, tool_use_id: tool, status: ok ? "completed" : "stopped",
      summary: ok ? `Background command "${command}" completed (exit code 0)` : `Background command "${command}" was stopped`, session_id: session, uuid: uuid() });
    out(bgList());
    run(() => turn("", id));
  });
  if (!late) return onExit(child);
  const gate = process.env.FAKE_CLAUDE_BG_GATE;
  while (gate && !fs.existsSync(gate)) await new Promise((r) => setTimeout(r, 20));
  onExit(spawn());
}
let costTotal = 0, outTotal = 0;         // cumulative for the process, as claude reports them

// done is the id of the background command that ended when this turn began by itself, else "".
async function turn(text, done = "") {
  if (stdinClosed) log({ turn: "self" });
  let aborted = false, wake = null;
  current = { cancel: () => { aborted = true; wake?.(); } };
  if (!done) out({ type: "system", subtype: "init", cwd: process.cwd(), session_id: session, model, tools: [], mcp_servers: [] });
  out({ type: "system", subtype: "status", status: "requesting", session_id: session });
  const plain = text.replace(DIRECTIVE, "").trim();
  let reply = done ? `${done} done` : `FAKE(${model}): ${plain}`, error = "", cost = 0, on = true, started = false;
  if (finalText !== null && text.trimStart().startsWith("<subagent-results>")) {
    reply = finalText; text = "";
  }
  for (const [, a, b, c, d] of text.matchAll(DIRECTIVE)) {
    const verb = a ?? c, rest = b ?? d;
    if (aborted) break;
    if (verb === "if") { on = rest === "" || plain.includes(rest); continue; }
    if (!on) continue;
    if (verb === "sleep") await new Promise((r) => { wake = r; setTimeout(r, Number(rest) * 1000); });
    else if (verb === "exit") process.exit(Number(rest) || 1);
    else if (verb === "fail") error = rest || "fake failure";
    else if (verb === "final") finalText = rest;
    else if (verb === "cost") cost += Number(rest) || 0;
    else if (verb === "leave") leaving = true;
    else if (verb === "bg") { bgStart(rest.trim() || "60"); started = true; }
    else if (verb === "bglate") { await bgStart(rest.trim() || "60", true); started = true; }
    else if (verb === "write") {
      const sp = rest.indexOf(" "), file = require("node:path").resolve(sp < 0 ? rest : rest.slice(0, sp));
      const body = (sp < 0 ? "" : rest.slice(sp + 1)).replaceAll("\\n", "\n") + "\n";
      const id = "toolu_" + uuid().slice(0, 8);
      out({ type: "assistant", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { id: "msg_" + uuid().slice(0, 8), role: "assistant", model, content: [{ type: "tool_use", id, name: "Write", input: { file_path: file, content: body } }] } });
      let result = "written";
      try { fs.mkdirSync(require("node:path").dirname(file), { recursive: true }); fs.writeFileSync(file, body); } catch (e) { result = "write failed: " + e.message; }
      out({ type: "user", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, content: result }] } });
      reply += `\nwrite ${sp < 0 ? rest : rest.slice(0, sp)} -> ${result}`;
    }
    else if (verb === "ask") {
      const sp = rest.indexOf(" "), name = (sp < 0 ? rest : rest.slice(0, sp)) || "Bash", input = sp < 0 ? {} : JSON.parse(rest.slice(sp + 1));
      const id = "toolu_" + uuid().slice(0, 8), rid = "perm_" + uuid().slice(0, 8);
      out({ type: "assistant", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { id: "msg_" + uuid().slice(0, 8), role: "assistant", model, content: [{ type: "tool_use", id, name, input }] } });
      out({ type: "control_request", request_id: rid, request: { subtype: "can_use_tool", tool_name: name, tool_use_id: id, input } });
      const answer = await new Promise((r) => { asks.set(rid, r); wake = () => r(null); });
      asks.delete(rid); wake = null;
      if (answer === null) break; // interrupted while it waited
      const allowed = answer.behavior === "allow";
      const result = allowed ? "allowed" : "denied: " + (answer.message || "");
      out({ type: "user", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, content: result, is_error: !allowed }] } });
      reply += `\nask ${name} -> ${allowed ? "allow" : "deny"}`;
    }
    else if (verb === "tools") {
      const body = mcp ? await rpc("tools/list", {}).catch((e) => ({ error: e.message })) : { error: "no --mcp-config" };
      reply += `\ntools -> [${(body.result?.tools || []).map((t) => t.name).join(", ")}]${body.error ? " " + JSON.stringify(body.error) : ""}`;
    }
    else if (verb === "mcp") {
      const sp = rest.indexOf(" "), name = sp < 0 ? rest : rest.slice(0, sp), input = sp < 0 ? {} : JSON.parse(rest.slice(sp + 1));
      const id = "toolu_" + uuid().slice(0, 8), full = "mcp__board__" + name;
      out({ type: "assistant", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { id: "msg_" + uuid().slice(0, 8), role: "assistant", model, content: [{ type: "tool_use", id, name: full, input }] } });
      const result = await callTool(name, input).catch((e) => "fetch failed: " + e.message);
      out({ type: "user", uuid: uuid(), session_id: session, parent_tool_use_id: null,
        message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, content: result }] } });
      reply += `\n${name} -> ${result}`;
    }
  }
  current = null;
  turns++;
  if (started && plain === "") reply = "waiting";
  const origin = done ? { origin: { kind: "task-notification" } } : {};
  // What the turn cost, as claude's result line says it: the total of the process so far, this
  // turn's output tokens, and the process's output tokens per model.
  const outNow = cost > 0 ? Math.round(cost * TOKENS_PER_USD) : 5;
  costTotal += cost; outTotal += outNow;
  const spent = { total_cost_usd: Number(costTotal.toFixed(6)),
    usage: { input_tokens: 10, output_tokens: outNow, cache_creation_input_tokens: 0, cache_read_input_tokens: 0 },
    modelUsage: { [model]: { inputTokens: 10 * turns, outputTokens: outTotal, cacheReadInputTokens: 1000 * turns,
      cacheCreationInputTokens: 100 * turns, contextWindow: 200000 } } };
  if (aborted) return out({ type: "result", subtype: "error_during_execution", is_error: true, terminal_reason: "aborted_streaming", num_turns: turns, session_id: session, ...origin, ...spent });
  if (error) return out({ type: "result", subtype: "error_during_execution", is_error: true, result: error, num_turns: turns, session_id: session, ...origin, ...spent });
  out({ type: "assistant", uuid: uuid(), session_id: session, parent_tool_use_id: null,
    message: { id: "msg_" + uuid().slice(0, 8), role: "assistant", model, content: [{ type: "text", text: reply }],
      usage: { input_tokens: 10, output_tokens: outNow, cache_creation_input_tokens: 0, cache_read_input_tokens: 0 } } });
  out({ type: "result", subtype: "success", is_error: false, result: reply, num_turns: turns, session_id: session, ...origin, ...spent });
}

// run queues work behind the turn in progress, so a turn that begins by itself comes after it.
let queue = Promise.resolve();
function run(job) {
  pending++;
  queue = queue.then(job).catch((e) => out({ type: "result", subtype: "error_during_execution", is_error: true, result: "fake claude crashed: " + e.message, num_turns: ++turns }))
    .then(async () => {
      pending--;
      if (leaving) {
        const gate = process.env.FAKE_CLAUDE_LEAVE_GATE;
        while (gate && !fs.existsSync(gate)) await new Promise((r) => setTimeout(r, 20));
        process.exit(0);
      }
      exitWhenDone();
    });
}
readline.createInterface({ input: process.stdin }).on("line", (line) => {
  let m; try { m = JSON.parse(line); } catch { return; }
  log({ stdin: m });
  if (m.type === "control_request") {
    const ok = (response) => out({ type: "control_response", response: { subtype: "success", request_id: m.request_id, response } });
    switch (m.request?.subtype) {
      case "initialize": return ok({ models: [
        { value: "sonnet", displayName: "Fake Sonnet", description: "scripted", supportedEffortLevels: ["low", "medium", "high"] },
        { value: "haiku", displayName: "Fake Haiku", description: "scripted" }] });
      case "interrupt": current?.cancel(); return ok({});
      default: return out({ type: "control_response", response: { subtype: "error", request_id: m.request_id, error: "fake claude: unsupported " + m.request?.subtype } });
    }
  }
  if (m.type === "control_response") { asks.get(m.response?.request_id)?.(m.response?.response || {}); return; }
  if (m.type === "user") {
    const text = (m.message?.content || []).map((c) => c.text ?? "").join("\n");
    run(() => turn(text));
  }
}).on("close", () => { stdinClosed = true; exitWhenDone(); });
